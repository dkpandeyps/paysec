  create_factory_runtime_root "$SOURCE_PAYSEC_DIR" "$FACTORY_PAYSEC"
  link_factory_skill_dirs "$SOURCE_PAYSEC_DIR" "$FACTORY_SKILLS"
  echo "paysec ready (factory)."
  echo "  browse: $BROWSE_BIN"
  echo "  factory skills: $FACTORY_SKILLS"
fi

