if [ "$INSTALL_CURSOR" -eq 1 ]; then
  mkdir -p "$CURSOR_SKILLS"
  create_cursor_runtime_root "$SOURCE_PAYSEC_DIR" "$CURSOR_PAYSEC"
  # Link before sidecar. Sidecar mkdir -p creates .cursor/skills/paysec, which
  # would make link_cursor_skill_dirs' "[ ! -d generated ]" gen fallback a no-op.
  link_cursor_skill_dirs "$SOURCE_PAYSEC_DIR" "$CURSOR_SKILLS"
