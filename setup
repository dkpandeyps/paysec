# ─── Helper: create a minimal ~/.cursor/skills/paysec runtime root ──────────
# Cursor scans ~/.cursor/skills. Same shape as the Codex/Factory/OpenCode
# runtime roots: root SKILL.md from the generated tree + runtime assets only.
# Contributed by @szsunyuan (PR #2547), re-derived onto the current installers.
create_cursor_runtime_root() {
  local paysec_dir="$1"
  local cursor_paysec="$2"
  local cursor_dir="$paysec_dir/.cursor/skills"
  local generated_root="$cursor_dir/paysec"

  if [ -L "$cursor_paysec" ]; then
    rm -f "$cursor_paysec"
  elif _sidecar_root_user_owned "$cursor_paysec"; then
    # #2142: a hand-written skill squatting on the canonical name is the
    # user's — never wipe it to make room for the runtime root.
    echo "  left in place (existing dir not paysec-managed — no generated banner): $cursor_paysec" >&2
    return 0
  elif [ -d "$cursor_paysec" ] && [ "$cursor_paysec" != "$paysec_dir" ] && [ "$cursor_paysec" != "$generated_root" ]; then
    rm -rf "$cursor_paysec"
  fi

  mkdir -p "$cursor_paysec" "$cursor_paysec/browser" "$cursor_paysec/paysec-upgrade" "$cursor_paysec/pr-review"

  if [ -f "$cursor_dir/paysec/SKILL.md" ]; then
    _link_or_copy "$cursor_dir/paysec/SKILL.md" "$cursor_paysec/SKILL.md"
  fi
  # bin scripts import shared modules via ../lib — bin and lib travel together.
  if [ -d "$paysec_dir/bin" ]; then
    _link_or_copy "$paysec_dir/bin" "$cursor_paysec/bin"
  fi
  if [ -d "$paysec_dir/lib" ]; then
    _link_or_copy "$paysec_dir/lib" "$cursor_paysec/lib"
  fi
  if [ -d "$paysec_dir/browser/dist" ]; then
    _link_or_copy "$paysec_dir/browser/dist" "$cursor_paysec/browser/dist"
  fi
  if [ -d "$paysec_dir/browser/bin" ]; then
    _link_or_copy "$paysec_dir/browser/bin" "$cursor_paysec/browser/bin"
  fi
  if [ -f "$cursor_dir/paysec-upgrade/SKILL.md" ]; then
    _link_or_copy "$cursor_dir/paysec-upgrade/SKILL.md" "$cursor_paysec/paysec-upgrade/SKILL.md"
  fi
  # Review runtime assets — the cursor host config ships the lean pair.
  for f in checklist.md TODOS-format.md; do
    if [ -f "$paysec_dir/pr-review/$f" ]; then
      _link_or_copy "$paysec_dir/pr-review/$f" "$cursor_paysec/pr-review/$f"
    fi
  done
  if [ -f "$paysec_dir/ETHOS.md" ]; then
    _link_or_copy "$paysec_dir/ETHOS.md" "$cursor_paysec/ETHOS.md"
  fi
  # supabase/config.sh — required by paysec-telemetry-sync to resolve PAYSEC_SUPABASE_URL
  if [ -f "$paysec_dir/supabase/config.sh" ]; then
    mkdir -p "$cursor_paysec/supabase"
    _link_or_copy "$paysec_dir/supabase/config.sh" "$cursor_paysec/supabase/config.sh"
  fi
}

# Plant runtime assets into the repo-local generated skill dir so in-repo
# PAYSEC_ROOT (preamble prefers $_ROOT/.cursor/skills/paysec) has bin/.
# NEVER wipe this directory — it holds the generated SKILL.md files.
create_cursor_sidecar() {
  local repo_root="$1"
  local cursor_paysec="$repo_root/.cursor/skills/paysec"
  local cursor_dir="$repo_root/.cursor/skills"

  # #2142: same user-ownership gate as create_agents_sidecar — but the
  # generated tree's own root (cursor_dir/paysec carries the banner) always
  # passes, so normal installs refresh as before.
  if _sidecar_root_user_owned "$cursor_paysec"; then
    echo "  left in place (existing dir not paysec-managed — no generated banner): $cursor_paysec" >&2
    return 0
  fi

  mkdir -p "$cursor_paysec" "$cursor_paysec/browser" "$cursor_paysec/paysec-upgrade" "$cursor_paysec/pr-review"

  if [ -d "$repo_root/bin" ]; then
    if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/bin" ] || [ ! -e "$cursor_paysec/bin" ]; then
      _link_or_copy "$repo_root/bin" "$cursor_paysec/bin"
    fi
  fi
  if [ -d "$repo_root/lib" ]; then
    if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/lib" ] || [ ! -e "$cursor_paysec/lib" ]; then
      _link_or_copy "$repo_root/lib" "$cursor_paysec/lib"
    fi
  fi
  if [ -d "$repo_root/browser/dist" ]; then
    if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/browser/dist" ] || [ ! -e "$cursor_paysec/browser/dist" ]; then
      _link_or_copy "$repo_root/browser/dist" "$cursor_paysec/browser/dist"
    fi
  fi
  if [ -d "$repo_root/browser/bin" ]; then
    if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/browser/bin" ] || [ ! -e "$cursor_paysec/browser/bin" ]; then
      _link_or_copy "$repo_root/browser/bin" "$cursor_paysec/browser/bin"
    fi
  fi
  if [ -f "$cursor_dir/paysec-upgrade/SKILL.md" ]; then
    if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/paysec-upgrade/SKILL.md" ] || [ ! -e "$cursor_paysec/paysec-upgrade/SKILL.md" ]; then
      _link_or_copy "$cursor_dir/paysec-upgrade/SKILL.md" "$cursor_paysec/paysec-upgrade/SKILL.md"
    fi
  fi
  for f in checklist.md TODOS-format.md; do
    if [ -f "$repo_root/pr-review/$f" ]; then
      if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/pr-review/$f" ] || [ ! -e "$cursor_paysec/pr-review/$f" ]; then
        _link_or_copy "$repo_root/pr-review/$f" "$cursor_paysec/pr-review/$f"
      fi
    fi
  done
  if [ -f "$repo_root/ETHOS.md" ]; then
    if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$cursor_paysec/ETHOS.md" ] || [ ! -e "$cursor_paysec/ETHOS.md" ]; then
      _link_or_copy "$repo_root/ETHOS.md" "$cursor_paysec/ETHOS.md"
    fi
  fi
}

link_cursor_skill_dirs() {
  local paysec_dir="$1"
  local skills_dir="$2"
  local cursor_dir="$paysec_dir/.cursor/skills"
  local linked=()

  if [ ! -d "$cursor_dir" ]; then
    echo "  Generating .cursor/ skill docs..."
    ( cd "$paysec_dir" && bun_cmd run gen:skill-docs --host cursor )
  fi

  if [ ! -d "$cursor_dir" ]; then
    echo "  warning: .cursor/skills/ generation failed — run 'bun run gen:skill-docs --host cursor' manually" >&2
    return 1
  fi

  for skill_dir in "$cursor_dir"/paysec*/; do
    if [ -f "$skill_dir/SKILL.md" ]; then
      skill_name="$(basename "$skill_dir")"
      [ "$skill_name" = "paysec" ] && continue
      target="$skills_dir/$skill_name"
      # #2444: IS_WINDOWS bypass — real-dir copies never match -L, so re-runs
      # skipped the refresh. Only replace a symlink, a missing path, or a
      # PROVABLY paysec-managed real dir; never a user's own Cursor skill
      # dir that merely starts with paysec (#2142).
      if [ "$IS_WINDOWS" -eq 1 ] || [ -L "$target" ] || [ ! -e "$target" ]; then
        if _owned_for_windows_refresh "$target"; then
          _link_or_copy "$skill_dir" "$target"
          linked+=("$skill_name")
        else
          echo "  left in place (existing dir not paysec-managed — no generated banner): $target" >&2
        fi
      fi
    fi
  done
  if [ ${#linked[@]} -gt 0 ]; then
    echo "  linked skills: ${linked[*]}"
  fi
}

# 4. Install for Claude (default)
SKILLS_BASENAME="$(basename "$INSTALL_SKILLS_DIR")"
SKILLS_PARENT_BASENAME="$(basename "$(dirname "$INSTALL_SKILLS_DIR")")"
CODEX_REPO_LOCAL=0
if [ "$SKILLS_BASENAME" = "skills" ] && [ "$SKILLS_PARENT_BASENAME" = ".agents" ]; then
  CODEX_REPO_LOCAL=1
fi

if [ "$INSTALL_CLAUDE" -eq 1 ]; then
  if [ "$SKILLS_BASENAME" = "skills" ]; then
    # Clean up stale symlinks from the opposite prefix mode
    if [ "$SKILL_PREFIX" -eq 1 ]; then
      cleanup_old_claude_symlinks "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
    else
      cleanup_prefixed_claude_symlinks "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
    fi
    # Patch name: fields BEFORE creating symlinks so link_claude_skill_dirs
    # reads the correct (patched) name: values for symlink naming
    "$SOURCE_PAYSEC_DIR/bin/paysec-patch-names" "$SOURCE_PAYSEC_DIR" "$SKILL_PREFIX"
    link_claude_skill_dirs "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
    link_claude_root_skill_alias "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
    _CLAUDE_SKILLS_LINKED=1
    # Self-healing: re-run paysec-relink to ensure name: fields and directory
    # names are consistent with the config. This catches cases where an interrupted
    # setup, stale git state, or gen:skill-docs left name: fields out of sync.
    PAYSEC_RELINK="$SOURCE_PAYSEC_DIR/bin/paysec-relink"
    if [ -x "$PAYSEC_RELINK" ]; then
      PAYSEC_SKILLS_DIR="$INSTALL_SKILLS_DIR" PAYSEC_INSTALL_DIR="$SOURCE_PAYSEC_DIR" "$PAYSEC_RELINK" >/dev/null 2>&1 || true
    fi
    # Backwards-compat alias: /connect-chrome → /open-paysec-browser
    # Rewritten copy, not a symlink: a symlinked alias re-serves the canonical
    # name: open-paysec-browser, so one of the two silently shadows the other
    # (#2201) — and duplicate names can drop the whole skill set (#2511).
    _OGB_LINK="$INSTALL_SKILLS_DIR/connect-chrome"
    _OGB_ALIAS_NAME="connect-chrome"
    if [ "$SKILL_PREFIX" -eq 1 ]; then
      _OGB_LINK="$INSTALL_SKILLS_DIR/paysec-connect-chrome"
      _OGB_ALIAS_NAME="paysec-connect-chrome"
    fi
    _install_alias_skill_md "$SOURCE_PAYSEC_DIR/open-paysec-browser/SKILL.md" "$_OGB_LINK" "$_OGB_ALIAS_NAME"
    if [ "$LOCAL_INSTALL" -eq 1 ]; then
      log "paysec ready (project-local)."
      log "  skills: $INSTALL_SKILLS_DIR"
    else
      log "paysec ready (claude)."
    fi
    log "  browse: $BROWSE_BIN"
  else
    # Not inside a skills/ directory — would symlink the source into
    # ~/.claude/skills/paysec/ and register from there.
    CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
    CLAUDE_PAYSEC_LINK="$CLAUDE_SKILLS_DIR/paysec"

    # Conductor worktree guard: if ~/.claude/skills/paysec is already a real
    # (non-symlink) directory pointing to a *different* install, refuse to plant
    # a symlink there. On macOS/BSD, `ln -snf SRC DST` won't replace a real DST;
    # it creates DST/$(basename SRC) → SRC inside it. The result is per-worktree
    # symlinks leaking into the global install that Claude Code picks up as
    # separate top-level skills (dublin-v1, lincoln-v2, ...). Typical trigger:
    # running ./setup from a Conductor worktree of the paysec repo itself.
    _SKIP_CLAUDE_REGISTER=0
    if [ -d "$CLAUDE_PAYSEC_LINK" ] && [ ! -L "$CLAUDE_PAYSEC_LINK" ]; then
      _EXISTING_REAL=$(cd "$CLAUDE_PAYSEC_LINK" 2>/dev/null && pwd -P || echo "")
      if [ -n "$_EXISTING_REAL" ] && [ "$_EXISTING_REAL" != "$SOURCE_PAYSEC_DIR" ]; then
        _SKIP_CLAUDE_REGISTER=1
      fi
    fi

    if [ "$_SKIP_CLAUDE_REGISTER" -eq 1 ]; then
      log ""
      log "  $CLAUDE_PAYSEC_LINK already exists as a separate global install."
      log "  Skipping Claude skill registration to avoid polluting it with"
      log "  per-worktree symlinks. (Binaries still built locally for dev.)"
      log ""
      log "    Global install:  $CLAUDE_PAYSEC_LINK"
      log "    This worktree:   $SOURCE_PAYSEC_DIR"
      log ""
      log "  To register this worktree as the active paysec, remove the global"
      log "  install first:  rm -rf $CLAUDE_PAYSEC_LINK"
      log ""
      log "paysec built (claude registration skipped)."
      log "  browse: $BROWSE_BIN"
    else
      mkdir -p "$CLAUDE_SKILLS_DIR"
      # Windows: prefer a REAL symlink for the global root. A copy goes stale (later edits and new
      # files never reach it) and re-runs then treat it as a "separate global install" and skip it.
      _link_or_copy "$SOURCE_PAYSEC_DIR" "$CLAUDE_PAYSEC_LINK" prefer-link
      if [ -L "$CLAUDE_PAYSEC_LINK" ]; then
        log "  symlinked $CLAUDE_PAYSEC_LINK -> $SOURCE_PAYSEC_DIR"
      else
        log "  copied $SOURCE_PAYSEC_DIR -> $CLAUDE_PAYSEC_LINK (turn on Windows Developer Mode for a live link;"
        log "  until then delete that copy and re-run ./setup after every change)"
      fi
      INSTALL_SKILLS_DIR="$CLAUDE_SKILLS_DIR"
      INSTALL_PAYSEC_DIR="$CLAUDE_PAYSEC_LINK"
      # Clean up stale symlinks from the opposite prefix mode
      if [ "$SKILL_PREFIX" -eq 1 ]; then
        cleanup_old_claude_symlinks "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
      else
        cleanup_prefixed_claude_symlinks "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
      fi
      "$SOURCE_PAYSEC_DIR/bin/paysec-patch-names" "$SOURCE_PAYSEC_DIR" "$SKILL_PREFIX"
      link_claude_skill_dirs "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
      link_claude_root_skill_alias "$SOURCE_PAYSEC_DIR" "$INSTALL_SKILLS_DIR"
      _CLAUDE_SKILLS_LINKED=1
      PAYSEC_RELINK="$SOURCE_PAYSEC_DIR/bin/paysec-relink"
      if [ -x "$PAYSEC_RELINK" ]; then
        PAYSEC_SKILLS_DIR="$INSTALL_SKILLS_DIR" PAYSEC_INSTALL_DIR="$SOURCE_PAYSEC_DIR" "$PAYSEC_RELINK" >/dev/null 2>&1 || true
      fi
      # Rewritten copy, not a symlink: a symlinked alias re-serves the
      # canonical name: open-paysec-browser, so one of the two silently
      # shadows the other (#2201) — and duplicate names can drop the whole
      # skill set (#2511).
      _OGB_LINK="$INSTALL_SKILLS_DIR/connect-chrome"
      _OGB_ALIAS_NAME="connect-chrome"
      if [ "$SKILL_PREFIX" -eq 1 ]; then
        _OGB_LINK="$INSTALL_SKILLS_DIR/paysec-connect-chrome"
        _OGB_ALIAS_NAME="paysec-connect-chrome"
      fi
      _install_alias_skill_md "$SOURCE_PAYSEC_DIR/open-paysec-browser/SKILL.md" "$_OGB_LINK" "$_OGB_ALIAS_NAME"
      log "paysec ready (claude)."
      log "  browse: $BROWSE_BIN"
    fi
  fi
fi

# 5. Install for Codex
if [ "$INSTALL_CODEX" -eq 1 ]; then
  if [ "$CODEX_REPO_LOCAL" -eq 1 ]; then
    CODEX_SKILLS="$INSTALL_SKILLS_DIR"
    CODEX_PAYSEC="$INSTALL_PAYSEC_DIR"
  fi
  mkdir -p "$CODEX_SKILLS"

  # Skip runtime root creation for repo-local installs — the checkout IS the runtime root.
  # create_codex_runtime_root would create self-referential symlinks (bin → bin, etc.).
  if [ "$CODEX_REPO_LOCAL" -eq 0 ]; then
    create_codex_runtime_root "$SOURCE_PAYSEC_DIR" "$CODEX_PAYSEC"
  fi
  # Install generated Codex-format skills (not Claude source dirs)
  link_codex_skill_dirs "$SOURCE_PAYSEC_DIR" "$CODEX_SKILLS"

  log "paysec ready (codex)."
  log "  browse: $BROWSE_BIN"
  log "  codex skills: $CODEX_SKILLS"
fi

# 6. Install for Kiro CLI (copy from .agents/skills, rewrite paths)
if [ "$INSTALL_KIRO" -eq 1 ]; then
  KIRO_SKILLS="$HOME/.kiro/skills"
  AGENTS_DIR="$SOURCE_PAYSEC_DIR/.agents/skills"
  mkdir -p "$KIRO_SKILLS"

  # Create paysec dir with symlinks for runtime assets, copy+sed for SKILL.md
  KIRO_PAYSEC="$KIRO_SKILLS/paysec"
  # Remove old whole-dir symlink from previous installs
  [ -L "$KIRO_PAYSEC" ] && rm -f "$KIRO_PAYSEC"
  mkdir -p "$KIRO_PAYSEC" "$KIRO_PAYSEC/browser" "$KIRO_PAYSEC/paysec-upgrade" "$KIRO_PAYSEC/pr-review"
  _link_or_copy "$SOURCE_PAYSEC_DIR/bin" "$KIRO_PAYSEC/bin"
  _link_or_copy "$SOURCE_PAYSEC_DIR/lib" "$KIRO_PAYSEC/lib"
  _link_or_copy "$SOURCE_PAYSEC_DIR/browser/dist" "$KIRO_PAYSEC/browser/dist"
  _link_or_copy "$SOURCE_PAYSEC_DIR/browser/bin" "$KIRO_PAYSEC/browser/bin"
  # ETHOS.md — referenced by "Search Before Building" in all skill preambles
  if [ -f "$SOURCE_PAYSEC_DIR/ETHOS.md" ]; then
    _link_or_copy "$SOURCE_PAYSEC_DIR/ETHOS.md" "$KIRO_PAYSEC/ETHOS.md"
  fi
  # supabase/config.sh — required by paysec-telemetry-sync to resolve PAYSEC_SUPABASE_URL
  if [ -f "$SOURCE_PAYSEC_DIR/supabase/config.sh" ]; then
    mkdir -p "$KIRO_PAYSEC/supabase"
    _link_or_copy "$SOURCE_PAYSEC_DIR/supabase/config.sh" "$KIRO_PAYSEC/supabase/config.sh"
  fi
  # paysec-upgrade skill
  if [ -f "$AGENTS_DIR/paysec-upgrade/SKILL.md" ]; then
    _link_or_copy "$AGENTS_DIR/paysec-upgrade/SKILL.md" "$KIRO_PAYSEC/paysec-upgrade/SKILL.md"
  fi
  # Review runtime assets (individual files, not whole dir)
  for f in checklist.md design-checklist.md greptile-triage.md TODOS-format.md; do
    if [ -f "$SOURCE_PAYSEC_DIR/pr-review/$f" ]; then
      _link_or_copy "$SOURCE_PAYSEC_DIR/pr-review/$f" "$KIRO_PAYSEC/pr-review/$f"
    fi
  done

  # Rewrite root SKILL.md paths for Kiro
  sed -e "s|~/.claude/skills/paysec|~/.kiro/skills/paysec|g" \
      -e "s|\.claude/skills/paysec|.kiro/skills/paysec|g" \
      -e "s|\.claude/skills|.kiro/skills|g" \
      "$SOURCE_PAYSEC_DIR/SKILL.md" > "$KIRO_PAYSEC/SKILL.md"

  if [ ! -d "$AGENTS_DIR" ]; then
    echo "  warning: no .agents/skills/ directory found — run 'bun run build' first" >&2
  else
    for skill_dir in "$AGENTS_DIR"/paysec*/; do
      [ -f "$skill_dir/SKILL.md" ] || continue
      skill_name="$(basename "$skill_dir")"
      target_dir="$KIRO_SKILLS/$skill_name"
      mkdir -p "$target_dir"
      # Generated Codex skills use $HOME/.codex (not ~/), plus $PAYSEC_ROOT variables.
      # Rewrite the default PAYSEC_ROOT value and any remaining literal paths.
      sed -e 's|\$HOME/.codex/skills/paysec|$HOME/.kiro/skills/paysec|g' \
          -e "s|~/.codex/skills/paysec|~/.kiro/skills/paysec|g" \
          -e "s|~/.claude/skills/paysec|~/.kiro/skills/paysec|g" \
          "$skill_dir/SKILL.md" > "$target_dir/SKILL.md"
      # Carved skills (v2 plan T9): rewrite + copy each sections/*.md the same way,
      # so a runtime "Read sections/<name>.md" resolves under ~/.kiro and doesn't
      # leak a ~/.codex or ~/.claude path. Kiro builds from the codex output, so
      # these section files only exist for skills that have been carved.
      if [ -d "$skill_dir/sections" ]; then
        mkdir -p "$target_dir/sections"
        for section_file in "$skill_dir/sections"/*; do
          [ -f "$section_file" ] || continue
          sed -e 's|\$HOME/.codex/skills/paysec|$HOME/.kiro/skills/paysec|g' \
              -e "s|~/.codex/skills/paysec|~/.kiro/skills/paysec|g" \
              -e "s|~/.claude/skills/paysec|~/.kiro/skills/paysec|g" \
              "$section_file" > "$target_dir/sections/$(basename "$section_file")"
        done
      fi
    done
    echo "paysec ready (kiro)."
    echo "  browse: $BROWSE_BIN"
    echo "  kiro skills: $KIRO_SKILLS"
  fi
fi

# 6b. Install for Factory Droid
if [ "$INSTALL_FACTORY" -eq 1 ]; then
