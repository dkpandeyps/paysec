#!/usr/bin/env bash
# paysec-team-init — generate repo-level bootstrap files for team mode
#
# Usage:
#   paysec-team-init optional   # gentle CLAUDE.md suggestion, one-time offer
#   paysec-team-init required   # CLAUDE.md enforcement + PreToolUse hook
#
# Run from the root of your team's repo (not from the paysec directory).

set -euo pipefail

MODE="${1:-}"

if [ "$MODE" != "optional" ] && [ "$MODE" != "required" ]; then
  echo "Usage: paysec-team-init {optional|required}" >&2
  echo "" >&2
  echo "  optional  — suggest paysec install once per developer (gentle)" >&2
  echo "  required  — enforce paysec install, block work without it" >&2
  exit 1
fi

# Must be in a git repo
if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "Error: not in a git repository. Run from your project root." >&2
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
CLAUDE_MD="$REPO_ROOT/CLAUDE.md"
GENERATED=()

# ── Migrate vendored copy if present ──────────────────────────

if [ -d "$REPO_ROOT/.claude/skills/paysec" ] && [ ! -L "$REPO_ROOT/.claude/skills/paysec" ]; then
  if [ -f "$REPO_ROOT/.claude/skills/paysec/VERSION" ] || [ -d "$REPO_ROOT/.claude/skills/paysec/.git" ]; then
    echo "  Found vendored paysec copy at $REPO_ROOT/.claude/skills/paysec"
    echo "  Team mode uses the global install — removing vendored copy..."
    ( cd "$REPO_ROOT" && git rm -r --cached .claude/skills/paysec/ 2>/dev/null ) || true
    if [ -f "$REPO_ROOT/.gitignore" ]; then
      if ! grep -qF '.claude/skills/paysec/' "$REPO_ROOT/.gitignore" 2>/dev/null; then
        echo '.claude/skills/paysec/' >> "$REPO_ROOT/.gitignore"
      fi
    else
      echo '.claude/skills/paysec/' > "$REPO_ROOT/.gitignore"
    fi
    rm -rf "$REPO_ROOT/.claude/skills/paysec"
    GENERATED+=(".gitignore")
    echo "  Removed vendored copy and added .claude/skills/paysec/ to .gitignore"
  fi
fi

# ── CLAUDE.md snippet ──────────────────────────────────────────

if [ "$MODE" = "optional" ]; then
  SNIPPET='## paysec (recommended)

This project uses paysec (a fork of [gstack](https://github.com/garrytan/gstack)) for AI-assisted workflows.
Install it for the best experience:

```bash
git clone --depth 1 "$PAYSEC_REMOTE_REPO" ~/.claude/skills/paysec
cd ~/.claude/skills/paysec && ./setup --team
```

Skills like /qa-fix, /ship-pr, /pr-review, /debug-root-cause, and /browser become available after install.
Use /browser for all web browsing. Use ~/.claude/skills/paysec/... for paysec file paths.'
else
  SNIPPET='## paysec (REQUIRED — global install)

**Before doing ANY work, verify paysec is installed:**

```bash
_GS=""
for _D in "${PAYSEC_ROOT:-}" "$HOME/.claude/skills/paysec" "$HOME/.codex/skills/paysec" "$HOME/.factory/skills/paysec" "$HOME/.kiro/skills/paysec" "$HOME/.config/opencode/skills/paysec" "$HOME/.slate/skills/paysec" "$HOME/.cursor/skills/paysec" "$HOME/.openclaw/skills/paysec" "$HOME/.hermes/skills/paysec" "$HOME/.gbrain/skills/paysec" "$HOME/.paysec/repos/paysec"; do
  [ -z "$_GS" ] && [ -n "$_D" ] && [ -d "$_D/bin" ] && _GS="$_D"
done
[ -n "$_GS" ] && echo "PAYSEC_OK: $_GS" || echo "PAYSEC_MISSING"
```

If PAYSEC_MISSING: STOP. Do not proceed. Tell the user:

> paysec is required for all AI-assisted work in this repo.
> Install it:
> ```bash
> git clone --depth 1 "$PAYSEC_REMOTE_REPO" ~/.claude/skills/paysec
> cd ~/.claude/skills/paysec && ./setup --team
> ```
> Then restart your AI coding tool.

Do not skip skills, ignore paysec errors, or work around missing paysec.

Using paysec skills: After install, skills like /qa-fix, /ship-pr, /pr-review, /debug-root-cause,
and /browser are available. Use /browser for all web browsing.
Use the resolved install path above for paysec file paths
(default: ~/.claude/skills/paysec).'
fi

# Check if CLAUDE.md already has a paysec section
if [ -f "$CLAUDE_MD" ] && grep -q "## paysec" "$CLAUDE_MD" 2>/dev/null; then
  echo "CLAUDE.md already has a paysec section. Skipping CLAUDE.md update."
  echo "  To replace it, remove the existing ## paysec section and re-run."
else
  if [ -f "$CLAUDE_MD" ]; then
    echo "" >> "$CLAUDE_MD"
  fi
  echo "$SNIPPET" >> "$CLAUDE_MD"
  GENERATED+=("CLAUDE.md")
  echo "  + CLAUDE.md — added paysec $MODE section"
fi

# ── Required mode: enforcement hook ────────────────────────────

if [ "$MODE" = "required" ]; then
  HOOKS_DIR="$REPO_ROOT/.claude/hooks"
  SETTINGS="$REPO_ROOT/.claude/settings.json"

  # Create enforcement hook script
  mkdir -p "$HOOKS_DIR"
  cat > "$HOOKS_DIR/check-paysec.sh" << 'HOOK_EOF'
#!/bin/bash
# Block skill usage when paysec is not installed globally.
#
# Resolve the install root the way paysec skill preambles do: the PAYSEC_ROOT
# env var first, then every host's global install location, then the migrated
# repo location. Block only when NONE exist (#2500 — hardcoding
# ~/.claude/skills/paysec false-blocked Codex-host and migrated-repo installs).
_PAYSEC_ROOT=""
for _D in "${PAYSEC_ROOT:-}" "$HOME/.claude/skills/paysec" "$HOME/.codex/skills/paysec" "$HOME/.factory/skills/paysec" "$HOME/.kiro/skills/paysec" "$HOME/.config/opencode/skills/paysec" "$HOME/.slate/skills/paysec" "$HOME/.cursor/skills/paysec" "$HOME/.openclaw/skills/paysec" "$HOME/.hermes/skills/paysec" "$HOME/.gbrain/skills/paysec" "$HOME/.paysec/repos/paysec"; do
  [ -z "$_PAYSEC_ROOT" ] && [ -n "$_D" ] && [ -d "$_D/bin" ] && _PAYSEC_ROOT="$_D"
done

if [ -z "$_PAYSEC_ROOT" ]; then
  cat >&2 <<'MSG'
BLOCKED: paysec is not installed globally.

paysec is required for AI-assisted work in this repo.

Install it:
  git clone --depth 1 "$PAYSEC_REMOTE_REPO" ~/.claude/skills/paysec
  cd ~/.claude/skills/paysec && ./setup --team

Then restart your AI coding tool.
MSG
  echo '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"paysec is required but not installed. See stderr for install instructions."}}'
  exit 2
fi

echo '{}'
HOOK_EOF
  chmod +x "$HOOKS_DIR/check-paysec.sh"
  GENERATED+=(".claude/hooks/check-paysec.sh")
  echo "  + .claude/hooks/check-paysec.sh — enforcement hook"

  # Add hook to project-level settings.json
  if command -v bun >/dev/null 2>&1; then
    PAYSEC_SETTINGS_PATH="$SETTINGS" bun -e "
      const fs = require('fs');
      const settingsPath = process.env.PAYSEC_SETTINGS_PATH;

      let settings = {};
      try { settings = JSON.parse(fs.readFileSync(settingsPath, 'utf8')); } catch {}

      if (!settings.hooks) settings.hooks = {};
      if (!settings.hooks.PreToolUse) settings.hooks.PreToolUse = [];

      // Dedup
      const exists = settings.hooks.PreToolUse.some(entry =>
        entry.matcher === 'Skill' &&
        entry.hooks && entry.hooks.some(h => h.command && h.command.includes('check-paysec'))
      );

      if (!exists) {
        settings.hooks.PreToolUse.push({
          matcher: 'Skill',
          hooks: [{
            type: 'command',
            command: '\"\$CLAUDE_PROJECT_DIR/.claude/hooks/check-paysec.sh\"'
          }]
        });
      }

      const tmp = settingsPath + '.tmp';
      fs.writeFileSync(tmp, JSON.stringify(settings, null, 2) + '\n');
      fs.renameSync(tmp, settingsPath);
    " 2>/dev/null
    GENERATED+=(".claude/settings.json")
    echo "  + .claude/settings.json — PreToolUse hook registered"
  else
    echo "  ! bun not found — manually add the PreToolUse hook to .claude/settings.json"
  fi
fi

# ── Summary ────────────────────────────────────────────────────

echo ""
echo "Team mode ($MODE) initialized."
echo ""
if [ ${#GENERATED[@]} -gt 0 ]; then
  echo "Commit the generated files:"
  echo "  git add ${GENERATED[*]}"
  echo "  git commit -m \"chore: require paysec for AI-assisted work\""
fi
echo ""
echo "Each developer then runs:"
echo "  git clone --depth 1 "$PAYSEC_REMOTE_REPO" ~/.claude/skills/paysec"
echo "  cd ~/.claude/skills/paysec && ./setup --team"
