#!/usr/bin/env bash
# paysec-builder-profile — LEGACY SHIM.
#
# Superseded by bin/paysec-developer-profile. This binary now delegates to
# `paysec-developer-profile --read` to keep /idea-review working during the
# transition. When all call sites have been updated, this file can be removed.
#
# The migration from ~/.paysec/builder-profile.jsonl to the unified
# ~/.paysec/developer-profile.json happens automatically on first read —
# see bin/paysec-developer-profile --migrate for details.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$SCRIPT_DIR/paysec-developer-profile" --read "$@"
