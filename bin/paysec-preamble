#!/usr/bin/env bash
# paysec-preamble — skill-start state probe for every paysec skill.
#
# Usage: paysec-preamble --skill <name> [--overlay <model>] [--ppid <pid>] [--brain-health]
#   --skill        skill name for the local analytics + timeline "started" events
#   --overlay      model overlay name echoed as MODEL_OVERLAY (default: none)
#   --ppid         the agent session's parent pid (pass "$PPID" from the skill's
#                  Bash call). Session markers key on it; this script's own $PPID
#                  would be the throwaway tool shell, not the agent session.
#   --brain-health also probe `gbrain doctor` (gbrain / hermes hosts)
#
# Called from the "## Preamble (run first)" block rendered by
# scripts/resolvers/preamble/generate-preamble-bash.ts. The body used to be
# inlined into every generated SKILL.md (~6KB each), which the agent re-typed
# as a Bash call on every skill run. Stdout (the KEY: value lines skills
# branch on) and the filesystem side effects are unchanged. Always exits 0.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

_SKILL="unknown"; _OVERLAY="none"; _PPID="$PPID"; _BRAIN_HEALTH=0
while [ $# -gt 0 ]; do
  case "$1" in
    --skill) _SKILL="${2:-unknown}"; shift 2 ;;
    --overlay) _OVERLAY="${2:-none}"; shift 2 ;;
    --ppid) _PPID="${2:-$PPID}"; shift 2 ;;
    --brain-health) _BRAIN_HEALTH=1; shift ;;
    *) shift ;;
  esac
done
# Values land in JSON strings and a file name: keep them to safe characters.
_SKILL=$(printf '%s' "$_SKILL" | tr -cd 'a-zA-Z0-9._-'); _SKILL="${_SKILL:-unknown}"
_OVERLAY=$(printf '%s' "$_OVERLAY" | tr -cd 'a-zA-Z0-9._-'); _OVERLAY="${_OVERLAY:-none}"
_PPID=$(printf '%s' "$_PPID" | tr -cd '0-9'); _PPID="${_PPID:-$PPID}"

_UPD=$("$SCRIPT_DIR/paysec-update-check" 2>/dev/null || true)
[ -n "$_UPD" ] && echo "$_UPD" || true
mkdir -p ~/.paysec/sessions
touch ~/.paysec/sessions/"$_PPID"
_SESSIONS=$(find ~/.paysec/sessions -mmin -120 -type f 2>/dev/null | wc -l | tr -d ' ')
find ~/.paysec/sessions -mmin +120 -type f -exec rm {} + 2>/dev/null || true
_PROACTIVE=$("$SCRIPT_DIR"/paysec-config get proactive 2>/dev/null || echo "true")
_PROACTIVE_PROMPTED=$([ -f ~/.paysec/.proactive-prompted ] && echo "yes" || echo "no")
_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
echo "BRANCH: $_BRANCH"
_SKILL_PREFIX=$("$SCRIPT_DIR"/paysec-config get skill_prefix 2>/dev/null || echo "false")
echo "PROACTIVE: $_PROACTIVE"
echo "PROACTIVE_PROMPTED: $_PROACTIVE_PROMPTED"
echo "SKILL_PREFIX: $_SKILL_PREFIX"
source <("$SCRIPT_DIR"/paysec-repo-mode 2>/dev/null) || true
REPO_MODE=${REPO_MODE:-unknown}
echo "REPO_MODE: $REPO_MODE"
_SESSION_KIND=$("$SCRIPT_DIR"/paysec-session-kind 2>/dev/null || echo "interactive")
case "$_SESSION_KIND" in spawned|headless|interactive) ;; *) _SESSION_KIND="interactive" ;; esac
echo "SESSION_KIND: $_SESSION_KIND"
# Conductor host: AskUserQuestion is unreliable here (native disabled, MCP
# variant flaky), so skills render decisions as prose instead of calling the
# tool. Gated on !headless so an eval/CI run INSIDE Conductor (PAYSEC_HEADLESS)
# still BLOCKs rather than rendering prose to nobody.
if [ "$_SESSION_KIND" != "headless" ] && { [ -n "${CONDUCTOR_WORKSPACE_PATH:-}" ] || [ -n "${CONDUCTOR_PORT:-}" ]; }; then
  echo "CONDUCTOR_SESSION: true"
fi
_ACTIVATED=$([ -f ~/.paysec/.activated ] && echo "yes" || echo "no")
_FIRST_LOOP_SHOWN=$([ -f ~/.paysec/.first-loop-tip-shown ] && echo "yes" || echo "no")
echo "ACTIVATED: $_ACTIVATED"
echo "FIRST_LOOP_SHOWN: $_FIRST_LOOP_SHOWN"
# First-run project detection: run the detector ONLY on the first-ever skill run
# (ACTIVATED=no, interactive) so it stays off the hot path for every run after.
_FIRST_TASK=""
if [ "$_ACTIVATED" = "no" ] && [ "$_SESSION_KIND" != "headless" ]; then
  _FIRST_TASK=$("$SCRIPT_DIR"/paysec-first-task-detect 2>/dev/null || true)
fi
echo "FIRST_TASK: $_FIRST_TASK"
_LAKE_SEEN=$([ -f ~/.paysec/.completeness-intro-seen ] && echo "yes" || echo "no")
echo "LAKE_INTRO: $_LAKE_SEEN"
_TEL=$("$SCRIPT_DIR"/paysec-config get telemetry 2>/dev/null || true)
_TEL_PROMPTED=$([ -f ~/.paysec/.telemetry-prompted ] && echo "yes" || echo "no")
_TEL_START=$(date +%s)
_SESSION_ID="$$-$(date +%s)"
echo "TELEMETRY: ${_TEL:-off}"
echo "TEL_PROMPTED: $_TEL_PROMPTED"
_EXPLAIN_LEVEL=$("$SCRIPT_DIR"/paysec-config get explain_level 2>/dev/null || echo "default")
if [ "$_EXPLAIN_LEVEL" != "default" ] && [ "$_EXPLAIN_LEVEL" != "terse" ]; then _EXPLAIN_LEVEL="default"; fi
echo "EXPLAIN_LEVEL: $_EXPLAIN_LEVEL"
_QUESTION_TUNING=$("$SCRIPT_DIR"/paysec-config get question_tuning 2>/dev/null || echo "false")
echo "QUESTION_TUNING: $_QUESTION_TUNING"
_UPDATE_CHECK=$("$SCRIPT_DIR"/paysec-config get update_check 2>/dev/null || echo "true")
echo "UPDATE_CHECK: $_UPDATE_CHECK"
mkdir -p ~/.paysec/analytics
if [ "$_TEL" != "off" ]; then
echo '{"skill":"'"$_SKILL"'","ts":"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'","repo":"'$(_repo=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null | tr -cd 'a-zA-Z0-9._-'); echo "${_repo:-unknown}")'"}'  >> ~/.paysec/analytics/skill-usage.jsonl 2>/dev/null || true
fi
for _PF in $(find ~/.paysec/analytics -maxdepth 1 -name '.pending-*' 2>/dev/null); do
  if [ -f "$_PF" ]; then
    if [ "$_TEL" != "off" ] && [ -x "$SCRIPT_DIR/paysec-telemetry-log" ]; then
      "$SCRIPT_DIR"/paysec-telemetry-log --event-type skill_run --skill _pending_finalize --outcome unknown --session-id "$_SESSION_ID" 2>/dev/null || true
    fi
    rm -f "$_PF" 2>/dev/null || true
  fi
  break
done
eval "$("$SCRIPT_DIR"/paysec-slug 2>/dev/null)" 2>/dev/null || true
_LEARN_FILE="${PAYSEC_HOME:-$HOME/.paysec}/projects/${SLUG:-unknown}/learnings.jsonl"
if [ -f "$_LEARN_FILE" ]; then
  _LEARN_COUNT=$(wc -l < "$_LEARN_FILE" 2>/dev/null | tr -d ' ')
  echo "LEARNINGS: $_LEARN_COUNT entries loaded"
  if [ "$_LEARN_COUNT" -gt 5 ] 2>/dev/null; then
    "$SCRIPT_DIR"/paysec-learnings-search --limit 3 2>/dev/null || true
  fi
else
  echo "LEARNINGS: 0"
fi
"$SCRIPT_DIR"/paysec-timeline-log '{"skill":"'"$_SKILL"'","event":"started","branch":"'"$_BRANCH"'","session":"'"$_SESSION_ID"'"}' 2>/dev/null &
_HAS_ROUTING="no"
for _RF in CLAUDE.md AGENTS.md; do
  if [ -f "$_RF" ] && grep -q "## Skill routing" "$_RF" 2>/dev/null; then
    _HAS_ROUTING="yes"
  fi
done
_ROUTING_DECLINED=$("$SCRIPT_DIR"/paysec-config get routing_declined 2>/dev/null || echo "false")
echo "HAS_ROUTING: $_HAS_ROUTING"
echo "ROUTING_DECLINED: $_ROUTING_DECLINED"
_VENDORED="no"
if [ -d ".claude/skills/paysec" ] && [ ! -L ".claude/skills/paysec" ]; then
  if [ -f ".claude/skills/paysec/VERSION" ] || [ -d ".claude/skills/paysec/.git" ]; then
    _VENDORED="yes"
  fi
fi
echo "VENDORED_PAYSEC: $_VENDORED"
echo "MODEL_OVERLAY: $_OVERLAY"
_CHECKPOINT_MODE=$("$SCRIPT_DIR"/paysec-config get checkpoint_mode 2>/dev/null || echo "explicit")
_CHECKPOINT_PUSH=$("$SCRIPT_DIR"/paysec-config get checkpoint_push 2>/dev/null || echo "false")
echo "CHECKPOINT_MODE: $_CHECKPOINT_MODE"
echo "CHECKPOINT_PUSH: $_CHECKPOINT_PUSH"
# Plan-mode hint for skills like /write-spec that branch behavior on plan-mode state.
# Claude Code exposes plan mode via system reminders; we detect best-effort
# from CLAUDE_PLAN_FILE (set by the harness when plan mode is active) and
# fall back to "inactive". Codex hosts and Claude execution mode both end up
# inactive, which is the safe default (defaults to file+execute pipeline).
if [ -n "${CLAUDE_PLAN_FILE:-}${PAYSEC_PLAN_MODE_FORCE:-}" ]; then
  export PAYSEC_PLAN_MODE="active"
elif [ "${PAYSEC_PLAN_MODE:-}" = "active" ]; then
  export PAYSEC_PLAN_MODE="active"
else
  export PAYSEC_PLAN_MODE="inactive"
fi
echo "PAYSEC_PLAN_MODE: $PAYSEC_PLAN_MODE"
[ -n "$OPENCLAW_SESSION" ] && echo "SPAWNED_SESSION: true" || true

if [ "$_BRAIN_HEALTH" = "1" ]; then
  if command -v gbrain &>/dev/null; then
    _BRAIN_JSON=$(gbrain doctor --fast --json 2>/dev/null || echo '{}')
    _BRAIN_SCORE=$(echo "$_BRAIN_JSON" | grep -o '"health_score":[0-9]*' | cut -d: -f2)
    _BRAIN_FAILS=$(echo "$_BRAIN_JSON" | grep -o '"status":"fail"' | wc -l | tr -d ' ')
    _BRAIN_WARNS=$(echo "$_BRAIN_JSON" | grep -o '"status":"warn"' | wc -l | tr -d ' ')
    echo "BRAIN_HEALTH: ${_BRAIN_SCORE:-unknown} (${_BRAIN_FAILS:-0} failures, ${_BRAIN_WARNS:-0} warnings)"
    if [ "${_BRAIN_SCORE:-100}" -lt 50 ] 2>/dev/null; then
      echo "$_BRAIN_JSON" | grep -o '"name":"[^"]*","status":"[^"]*","message":"[^"]*"' || true
    fi
  fi
fi
exit 0
